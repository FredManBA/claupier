{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "La mesa: lee datos y ajustes, ajusta su tamaño y se arrastra",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-get-settings",
    "allow-update-settings",
    "allow-refresh-now",
    "allow-open-settings",
    "allow-fit-window"
  ]
}
