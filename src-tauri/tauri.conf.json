{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claupier",
  "version": "0.1.0",
  "identifier": "com.needyfriends.claupier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claupier",
        "width": 300,
        "height": 351,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "ajustes",
        "title": "Ajustes de Claupier",
        "url": "settings.html",
        "width": 760,
        "height": 720,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NeedyFriends",
    "copyright": "Copyright (c) 2026 NeedyFriends. MIT License.",
    "homepage": "https://github.com/FredManBA/claupier",
    "category": "Utility",
    "shortDescription": "Claude usage as a pixel art casino table",
    "longDescription": "Claupier shows your Claude Code usage (plan limits and equivalent spend) as a small pixel art casino table that stays on top of your games and apps.",
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}